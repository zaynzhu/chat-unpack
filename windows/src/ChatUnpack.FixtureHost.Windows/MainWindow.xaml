<Window x:Class="ChatUnpack.FixtureHost.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChatUnpack FixtureHost Windows"
        Width="900"
        Height="700"
        MinWidth="640"
        MinHeight="420"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <SolidColorBrush x:Key="FixtureWindowBrush" Color="#FFF5F6F8" />
    <SolidColorBrush x:Key="FixtureHeaderBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="FixtureCardBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="FixtureBorderBrush" Color="#FFE0E3E8" />
    <SolidColorBrush x:Key="FixtureTextBrush" Color="#FF202124" />
    <SolidColorBrush x:Key="FixtureMutedBrush" Color="#FF5F6368" />
    <SolidColorBrush x:Key="FixtureAccentBrush" Color="#FF315E9B" />
  </Window.Resources>

  <Grid x:Name="RootGrid"
        Background="{DynamicResource FixtureWindowBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Padding="24,18"
            Background="{DynamicResource FixtureHeaderBrush}"
            BorderBrush="{DynamicResource FixtureBorderBrush}"
            BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <TextBlock FontSize="24"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource FixtureTextBrush}"
                     Text="ChatUnpack FixtureHost" />
          <TextBlock Margin="0,8,0,0"
                     Foreground="{DynamicResource FixtureMutedBrush}">
            <Run Text="消息总数：" />
            <Run Text="{Binding MessageCount, Mode=OneWay}" />
            <Run Text=" · 完全虚构" />
          </TextBlock>
          <TextBlock Margin="0,4,0,0"
                     Foreground="{DynamicResource FixtureMutedBrush}"
                     Text="隔离测试窗口，不访问微信、文件或网络。" />
        </StackPanel>

        <Button x:Name="ThemeToggleButton"
                Grid.Column="1"
                MinWidth="112"
                Margin="18,0,0,0"
                Padding="12,8"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Click="ThemeToggleButton_Click"
                Content="切换深色"
                Foreground="{DynamicResource FixtureTextBrush}"
                ToolTip="切换浅色或深色显示" />
      </Grid>
    </Border>

    <ScrollViewer x:Name="MessagesScrollViewer"
                  Grid.Row="1"
                  Margin="18,14"
                  AutomationProperties.Name="虚构消息滚动区域"
                  CanContentScroll="True"
                  Focusable="True"
                  HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly"
                  VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Messages}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Margin="0,0,0,10"
                    Padding="14,12"
                    Background="{DynamicResource FixtureCardBrush}"
                    BorderBrush="{DynamicResource FixtureBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="180" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                  <TextBlock FontSize="12"
                             Foreground="{DynamicResource FixtureAccentBrush}"
                             Text="{Binding Index, StringFormat={}{0:D3}}" />
                  <TextBlock Margin="0,4,0,0"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource FixtureTextBrush}"
                             Text="{Binding Sender}" />
                  <TextBlock Margin="0,4,0,0"
                             Foreground="{DynamicResource FixtureMutedBrush}"
                             Text="{Binding Timestamp}" />
                  <TextBlock Margin="0,4,0,0"
                             Foreground="{DynamicResource FixtureMutedBrush}">
                    <Run Text="视口 " />
                    <Run Text="{Binding ViewportIndex, Mode=OneWay}" />
                  </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1">
                  <TextBlock FontSize="12"
                             Foreground="{DynamicResource FixtureAccentBrush}"
                             Text="{Binding Kind}" />
                  <TextBlock Margin="0,6,0,0"
                             FontSize="14"
                             Foreground="{DynamicResource FixtureTextBrush}"
                             Text="{Binding Body}"
                             TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <TextBlock Grid.Row="2"
               Margin="24,0,24,14"
               Foreground="{DynamicResource FixtureMutedBrush}"
               Text="FixtureHost 数据固定为 200 条；窗口不会自动滚动。" />
  </Grid>
</Window>
