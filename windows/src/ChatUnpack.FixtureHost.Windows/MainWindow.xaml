<Window x:Class="ChatUnpack.FixtureHost.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChatUnpack FixtureHost Windows"
        Width="720"
        Height="520"
        MinWidth="560"
        MinHeight="360"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="36">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="24" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               FontSize="28"
               FontWeight="SemiBold"
               Foreground="#202124"
               Text="ChatUnpack FixtureHost Windows" />

    <StackPanel Grid.Row="2" VerticalAlignment="Center">
      <TextBlock FontSize="18"
                 FontWeight="SemiBold"
                 Foreground="#202124"
                 Text="Windows v0.1 开发预览版，尚未在 Windows 构建/运行"
                 TextWrapping="Wrap" />
      <TextBlock Margin="0,16,0,0"
                 FontSize="14"
                 Foreground="#5F6368"
                 Text="当前阶段仅提供隔离的 FixtureHost 窗口壳，虚构记录将在后续阶段加入。"
                 TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</Window>
