<Window x:Class="ChatUnpack.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ChatUnpack.Windows"
        Title="ChatUnpack Windows v0.1"
        Width="900"
        Height="760"
        MinWidth="720"
        MinHeight="560"
        Background="{DynamicResource CueCanvas}"
        WindowStartupLocation="CenterScreen">
  <Window.InputBindings>
    <KeyBinding Command="{Binding ImportAddFromClipboardCommand}" Key="V" Modifiers="Ctrl" />
  </Window.InputBindings>
  <Window.Resources>
    <Style x:Key="IdlePanelStyle" TargetType="Grid">
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding State}" Value="{x:Static local:AppState.Idle}">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ImportingPanelStyle" TargetType="Grid">
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding State}" Value="{x:Static local:AppState.Importing}">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ConfirmingTargetPanelStyle" TargetType="Grid">
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding State}" Value="{x:Static local:AppState.ConfirmingTarget}">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="CountdownPanelStyle" TargetType="Grid">
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding State}" Value="{x:Static local:AppState.Countdown}">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ScanningPanelStyle" TargetType="Grid">
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding State}" Value="{x:Static local:AppState.Scanning}">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PausedPanelStyle" TargetType="Grid">
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding State}" Value="{x:Static local:AppState.Paused}">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ResultPanelStyle" TargetType="Grid">
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding State}" Value="{x:Static local:AppState.ResultEditing}">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ErrorPanelStyle" TargetType="Grid">
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding State}" Value="{x:Static local:AppState.Error}">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid Margin="24,20,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- 顶部说明区 -->
    <Border Grid.Row="0"
            Padding="18,14"
            Background="{DynamicResource CuePrimarySoft}"
            BorderBrush="{DynamicResource CueBorder}"
            BorderThickness="1"
            CornerRadius="10">
      <StackPanel>
        <TextBlock FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource CuePrimary}"
                   Text="ChatUnpack Windows v0.1" />
        <TextBlock Margin="0,6,0,0"
                   Style="{StaticResource CueBody}"
                   FontWeight="SemiBold"
                   Text="{Binding PreviewNotice}" />
        <TextBlock Margin="0,4,0,0"
                   Style="{StaticResource CueMuted}"
                   Text="{Binding PrivacyNotice}" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" Margin="0,22,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <DockPanel Grid.Row="0" Margin="2,0,2,14">
        <TextBlock DockPanel.Dock="Right"
                   VerticalAlignment="Center"
                   Style="{StaticResource CueCaption}"
                   Text="完全离线 · 本地处理" />
        <TextBlock Style="{StaticResource CueTitle}" Text="{Binding StateTitle}" />
      </DockPanel>

      <ScrollViewer Grid.Row="1"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <Grid>
          <!-- 待机页 -->
          <Grid Style="{StaticResource IdlePanelStyle}">
            <StackPanel MaxWidth="620"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
              <TextBlock Style="{StaticResource CueDisplay}"
                         HorizontalAlignment="Center"
                         Text="把聊天记录整理成 Markdown"
                         TextAlignment="Center" />
              <TextBlock Margin="0,14,0,0"
                         Style="{StaticResource CueMuted}"
                         HorizontalAlignment="Center"
                         Text="用微信自带截图（Alt+A）框选消息列表，贴到这里本地识别拼接；识别、去重、导出全部离线完成。"
                         TextAlignment="Center" />
              <Button Width="220"
                      Margin="0,28,0,12"
                      Command="{Binding OpenImportCommand}"
                      Content="从截图导入识别"
                      Style="{StaticResource CueBtnPrimary}" />
              <Button Width="220"
                      Margin="0,0,0,24"
                      Command="{Binding StartCommand}"
                      Content="自动扫描窗口（Fixture 调试）"
                      IsEnabled="{Binding AutoScanAvailable}"
                      Style="{StaticResource CueBtnSecondary}"
                      ToolTip="依赖窗口捕获；微信 4.x 已确认防截屏（WDA），此入口仅用于本地 Fixture 调试" />
              <Border Padding="16,12" Style="{StaticResource CueCard}">
                <StackPanel>
                  <TextBlock Style="{StaticResource CueBody}"
                             FontWeight="SemiBold"
                             Text="隐私边界" />
                  <TextBlock Margin="0,8,0,0"
                             Style="{StaticResource CueMuted}"
                             Text="截图只在内存中短暂存在，识别完成即释放；不落盘、不上传、不读取微信数据库、不操作微信窗口。" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>

          <!-- 导入截图页 -->
          <Grid Style="{StaticResource ImportingPanelStyle}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0"
                    Padding="16,12"
                    Style="{StaticResource CueCard}">
              <StackPanel>
                <TextBlock Style="{StaticResource CueBody}"
                           FontWeight="SemiBold"
                           Text="{Binding ImportImageSummary}" />
                <TextBlock Margin="0,6,0,0"
                           Style="{StaticResource CueMuted}"
                           Text="用微信截图（Alt+A）只框选消息列表，不要带窗口标题和侧栏；相邻截图保留一些重复内容即可，拼接时会自动去重。粘贴（Ctrl+V）或把图片文件拖到下方区域。"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <ItemsControl Grid.Row="1"
                          Margin="0,14,0,0"
                          AllowDrop="True"
                          Background="{DynamicResource CueSurfaceAlt}"
                          Drop="ImportPanel_Drop"
                          DragOver="ImportPanel_DragOver"
                          ItemsSource="{Binding ImportImages}"
                          Padding="10">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Width="180"
                          Margin="6"
                          Padding="10"
                          Style="{StaticResource CueCard}">
                    <StackPanel>
                      <Image Height="120"
                             Stretch="Uniform"
                             Source="{Binding Preview}" />
                      <TextBlock Margin="0,8,0,0"
                                 Style="{StaticResource CueCaption}"
                                 Text="{Binding DisplayName}" />
                      <Button Margin="0,8,0,0"
                              Command="{Binding DataContext.ImportRemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding}"
                              Content="移除"
                              Style="{StaticResource CueBtnSecondary}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Grid.Row="2" Margin="0,14,0,0">
              <TextBlock FontSize="13"
                         Foreground="{DynamicResource CuePrimary}"
                         Text="{Binding ImportProgressText}"
                         TextWrapping="Wrap">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsRecognizing}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <StackPanel Margin="0,10,0,0"
                          HorizontalAlignment="Right"
                          Orientation="Horizontal">
                <Button Margin="0,0,10,0"
                        Command="{Binding ImportAddFromClipboardCommand}"
                        Content="粘贴剪贴板图片"
                        Style="{StaticResource CueBtnSecondary}" />
                <Button Margin="0,0,10,0"
                        Command="{Binding ImportClearCommand}"
                        Content="清空"
                        Style="{StaticResource CueBtnSecondary}" />
                <Button Margin="0,0,10,0"
                        Command="{Binding CancelCommand}"
                        Content="返回待机"
                        Style="{StaticResource CueBtnSecondary}" />
                <Button Command="{Binding ImportStartCommand}"
                        Content="开始识别"
                        Style="{StaticResource CueBtnPrimary}" />
              </StackPanel>
            </StackPanel>
          </Grid>

          <!-- 目标确认页 -->
          <Grid Style="{StaticResource ConfirmingTargetPanelStyle}">
            <StackPanel MaxWidth="620" HorizontalAlignment="Center">
              <Border Padding="18,16"
                      Background="{DynamicResource CueWarnSoft}"
                      BorderBrush="{DynamicResource CueWarnBorder}"
                      BorderThickness="1"
                      CornerRadius="10">
                <StackPanel>
                  <TextBlock FontSize="16"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource CueWarnText}"
                             Text="这是完全虚构的目标，不是微信窗口" />
                  <TextBlock Margin="0,12,0,0"
                             Style="{StaticResource CueBody}"
                             FontWeight="SemiBold"
                             Text="来源：FakeCaptureCoordinator" />
                  <TextBlock Margin="0,8,0,0" Style="{StaticResource CueMuted}">
                    <Run Text="应用名：" />
                    <Run Text="{Binding Target.ApplicationName}" />
                  </TextBlock>
                  <TextBlock Margin="0,4,0,0" Style="{StaticResource CueMuted}">
                    <Run Text="窗口标题：" />
                    <Run Text="{Binding Target.WindowTitle}" />
                  </TextBlock>
                  <TextBlock Margin="0,4,0,0" Style="{StaticResource CueMuted}">
                    <Run Text="窗口尺寸：" />
                    <Run Text="{Binding Target.Width}" />
                    <Run Text=" × " />
                    <Run Text="{Binding Target.Height}" />
                  </TextBlock>
                </StackPanel>
              </Border>
              <TextBlock Margin="0,16,0,0"
                         Style="{StaticResource CueMuted}"
                         Text="确认后将运行 3 秒倒计时并生成内存中的虚构 Transcript；不会绑定或验证任何 HWND。" />
              <StackPanel Margin="0,24,0,0"
                          HorizontalAlignment="Center"
                          Orientation="Horizontal">
                <Button Margin="0,0,12,0"
                        Command="{Binding ConfirmTargetCommand}"
                        Content="确认虚构目标并开始"
                        Style="{StaticResource CueBtnPrimary}" />
                <Button Command="{Binding CancelCommand}"
                        Content="取消"
                        Style="{StaticResource CueBtnSecondary}" />
              </StackPanel>
            </StackPanel>
          </Grid>

          <!-- 倒计时页 -->
          <Grid Style="{StaticResource CountdownPanelStyle}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock FontSize="84"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource CuePrimary}"
                         HorizontalAlignment="Center"
                         Text="{Binding CountdownRemaining}" />
              <TextBlock Margin="0,14,0,0"
                         Style="{StaticResource CueTitle}"
                         HorizontalAlignment="Center"
                         Text="Fake 预览即将开始"
                         TextAlignment="Center" />
              <TextBlock Margin="0,8,0,0"
                         Style="{StaticResource CueMuted}"
                         HorizontalAlignment="Center"
                         Text="不会读取或操作微信；可以随时取消。"
                         TextAlignment="Center" />
              <Button Width="140"
                      Margin="0,28,0,0"
                      Command="{Binding CancelCommand}"
                      Content="取消"
                      Style="{StaticResource CueBtnSecondary}" />
            </StackPanel>
          </Grid>

          <!-- 扫描页 -->
          <Grid Style="{StaticResource ScanningPanelStyle}">
            <StackPanel MaxWidth="620" HorizontalAlignment="Center">
              <ProgressBar Margin="0,0,0,22"
                           Maximum="1"
                           Minimum="0"
                           Style="{StaticResource CueProgress}"
                           Value="{Binding Progress.Percent}" />
              <TextBlock Style="{StaticResource CueTitle}"
                         HorizontalAlignment="Center"
                         Text="{Binding ProgressPhaseName}" />
              <TextBlock Margin="0,8,0,0"
                         Style="{StaticResource CueMuted}"
                         HorizontalAlignment="Center"
                         Text="{Binding Progress.Reason}"
                         TextAlignment="Center" />
              <UniformGrid Margin="0,30,0,20" Columns="3">
                <StackPanel>
                  <TextBlock FontSize="26"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource CueText}"
                             HorizontalAlignment="Center"
                             Text="{Binding Progress.ViewportCount}" />
                  <TextBlock Margin="0,4,0,0"
                             Style="{StaticResource CueCaption}"
                             HorizontalAlignment="Center"
                             Text="视口" />
                </StackPanel>
                <StackPanel>
                  <TextBlock FontSize="26"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource CueText}"
                             HorizontalAlignment="Center"
                             Text="{Binding Progress.MessageCount}" />
                  <TextBlock Margin="0,4,0,0"
                             Style="{StaticResource CueCaption}"
                             HorizontalAlignment="Center"
                             Text="消息" />
                </StackPanel>
                <StackPanel>
                  <TextBlock FontSize="26"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource CueText}"
                             HorizontalAlignment="Center"
                             Text="{Binding Progress.LowConfidenceCount}" />
                  <TextBlock Margin="0,4,0,0"
                             Style="{StaticResource CueCaption}"
                             HorizontalAlignment="Center"
                             Text="存疑" />
                </StackPanel>
              </UniformGrid>
              <TextBlock Style="{StaticResource CueMuted}"
                         HorizontalAlignment="Center"
                         Text="{Binding ProgressDescription}" />
              <StackPanel Margin="0,28,0,0"
                          HorizontalAlignment="Center"
                          Orientation="Horizontal">
                <Button Margin="0,0,12,0"
                        Command="{Binding PauseCommand}"
                        Content="暂停"
                        Style="{StaticResource CueBtnSecondary}" />
                <Button Command="{Binding FinishPartialResultCommand}"
                        Content="停止并整理已有结果"
                        Style="{StaticResource CueBtnSecondary}" />
              </StackPanel>
            </StackPanel>
          </Grid>

          <!-- 暂停页 -->
          <Grid Style="{StaticResource PausedPanelStyle}">
            <StackPanel MaxWidth="580" HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Style="{StaticResource CueDisplay}"
                         HorizontalAlignment="Center"
                         Text="Fake 扫描已暂停" />
              <TextBlock Margin="0,14,0,0"
                         Style="{StaticResource CueMuted}"
                         HorizontalAlignment="Center"
                         Text="{Binding PauseReason}"
                         TextAlignment="Center" />
              <TextBlock Margin="0,8,0,0"
                         Style="{StaticResource CueMuted}"
                         HorizontalAlignment="Center"
                         Text="暂停只影响本地虚构数据生成，不代表真实窗口的暂停能力。"
                         TextAlignment="Center" />
              <StackPanel Margin="0,26,0,0"
                          HorizontalAlignment="Center"
                          Orientation="Horizontal">
                <Button Margin="0,0,12,0"
                        Command="{Binding ResumeCommand}"
                        Content="继续"
                        Style="{StaticResource CueBtnPrimary}" />
                <Button Command="{Binding FinishPartialResultCommand}"
                        Content="整理已有结果"
                        Style="{StaticResource CueBtnSecondary}" />
              </StackPanel>
            </StackPanel>
          </Grid>

          <!-- 结果编辑页 -->
          <Grid Style="{StaticResource ResultPanelStyle}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
              <TextBlock Style="{StaticResource CueTitle}" Text="结果预览" />
              <TextBlock Margin="0,6,0,14"
                         Style="{StaticResource CueMuted}"
                         Text="{Binding ResultSummary}" />
            </StackPanel>
            <TextBox Grid.Row="1"
                     MinHeight="260"
                     AcceptsReturn="True"
                     HorizontalScrollBarVisibility="Auto"
                     Style="{StaticResource CueTextBox}"
                     Text="{Binding MarkdownText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" />
            <TextBlock Grid.Row="2"
                       Margin="0,10,0,0"
                       FontSize="13"
                       Foreground="{DynamicResource CueWarnText}"
                       Text="{Binding UserMessage}"
                       TextWrapping="Wrap" />
            <StackPanel Grid.Row="3"
                        Margin="0,16,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
              <Button Margin="0,0,10,0"
                      Command="{Binding CopyMarkdownCommand}"
                      Content="{Binding CopyButtonTitle}"
                      Style="{StaticResource CueBtnPrimary}" />
              <Button Margin="0,0,10,0"
                      Command="{Binding SaveMarkdownCommand}"
                      Content="保存 Markdown"
                      Style="{StaticResource CueBtnSecondary}" />
              <Button Command="{Binding ClearResultCommand}"
                      Content="清除并返回待机"
                      Style="{StaticResource CueBtnSecondary}" />
            </StackPanel>
          </Grid>

          <!-- 错误页 -->
          <Grid Style="{StaticResource ErrorPanelStyle}">
            <StackPanel MaxWidth="600" HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Style="{StaticResource CueDisplay}"
                         HorizontalAlignment="Center"
                         Text="发生问题" />
              <TextBlock Margin="0,14,0,0"
                         FontSize="15"
                         Foreground="{DynamicResource CueError}"
                         HorizontalAlignment="Center"
                         Text="{Binding ErrorMessage}"
                         TextAlignment="Center"
                         TextWrapping="Wrap" />
              <Button Width="140"
                      Margin="0,26,0,0"
                      Command="{Binding ClearResultCommand}"
                      Content="返回待机"
                      Style="{StaticResource CueBtnSecondary}" />
            </StackPanel>
          </Grid>
        </Grid>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>