<Window x:Class="ChatUnpack.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ChatUnpack.Windows"
        Title="ChatUnpack Windows v0.1"
        Width="900"
        Height="760"
        MinWidth="720"
        MinHeight="560"
        Background="{DynamicResource CueCanvas}"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style x:Key="IdlePanelStyle" TargetType="Grid">
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding State}" Value="{x:Static local:AppState.Idle}">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ConfirmingTargetPanelStyle" TargetType="Grid">
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding State}" Value="{x:Static local:AppState.ConfirmingTarget}">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="CountdownPanelStyle" TargetType="Grid">
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding State}" Value="{x:Static local:AppState.Countdown}">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ScanningPanelStyle" TargetType="Grid">
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding State}" Value="{x:Static local:AppState.Scanning}">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PausedPanelStyle" TargetType="Grid">
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding State}" Value="{x:Static local:AppState.Paused}">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ResultPanelStyle" TargetType="Grid">
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding State}" Value="{x:Static local:AppState.ResultEditing}">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ErrorPanelStyle" TargetType="Grid">
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding State}" Value="{x:Static local:AppState.Error}">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid Margin="24,20,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- 顶部说明区 -->
    <Border Grid.Row="0"
            Padding="18,14"
            Background="{DynamicResource CuePrimarySoft}"
            BorderBrush="{DynamicResource CueBorder}"
            BorderThickness="1"
            CornerRadius="10">
      <StackPanel>
        <TextBlock FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource CuePrimary}"
                   Text="ChatUnpack Windows v0.1" />
        <TextBlock Margin="0,6,0,0"
                   Style="{StaticResource CueBody}"
                   FontWeight="SemiBold"
                   Text="{Binding PreviewNotice}" />
        <TextBlock Margin="0,4,0,0"
                   Style="{StaticResource CueMuted}"
                   Text="{Binding PrivacyNotice}" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" Margin="0,22,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <DockPanel Grid.Row="0" Margin="2,0,2,14">
        <TextBlock DockPanel.Dock="Right"
                   VerticalAlignment="Center"
                   Style="{StaticResource CueCaption}"
                   Text="仅限本地 Fake 预览" />
        <TextBlock Style="{StaticResource CueTitle}" Text="{Binding StateTitle}" />
      </DockPanel>

      <ScrollViewer Grid.Row="1"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <Grid>
          <!-- 待机页 -->
          <Grid Style="{StaticResource IdlePanelStyle}">
            <StackPanel MaxWidth="620"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
              <TextBlock Style="{StaticResource CueDisplay}"
                         HorizontalAlignment="Center"
                         Text="把虚构记录整理成 Markdown"
                         TextAlignment="Center" />
              <TextBlock Margin="0,14,0,0"
                         Style="{StaticResource CueMuted}"
                         HorizontalAlignment="Center"
                         Text="点击开始后只会进入 FakeCaptureCoordinator，生成固定的虚构数据。"
                         TextAlignment="Center" />
              <Button Width="200"
                      Margin="0,28,0,24"
                      Command="{Binding StartCommand}"
                      Content="开始 Fake 预览"
                      Style="{StaticResource CueBtnPrimary}" />
              <Border Padding="16,12" Style="{StaticResource CueCard}">
                <StackPanel>
                  <TextBlock Style="{StaticResource CueBody}"
                             FontWeight="SemiBold"
                             Text="当前范围" />
                  <TextBlock Margin="0,8,0,0"
                             Style="{StaticResource CueMuted}"
                             Text="不定位前台窗口，不读取窗口标题，不访问微信进程，不进行真实捕获、OCR 或滚动。" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>

          <!-- 目标确认页 -->
          <Grid Style="{StaticResource ConfirmingTargetPanelStyle}">
            <StackPanel MaxWidth="620" HorizontalAlignment="Center">
              <Border Padding="18,16"
                      Background="{DynamicResource CueWarnSoft}"
                      BorderBrush="{DynamicResource CueWarnBorder}"
                      BorderThickness="1"
                      CornerRadius="10">
                <StackPanel>
                  <TextBlock FontSize="16"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource CueWarnText}"
                             Text="这是完全虚构的目标，不是微信窗口" />
                  <TextBlock Margin="0,12,0,0"
                             Style="{StaticResource CueBody}"
                             FontWeight="SemiBold"
                             Text="来源：FakeCaptureCoordinator" />
                  <TextBlock Margin="0,8,0,0" Style="{StaticResource CueMuted}">
                    <Run Text="应用名：" />
                    <Run Text="{Binding Target.ApplicationName}" />
                  </TextBlock>
                  <TextBlock Margin="0,4,0,0" Style="{StaticResource CueMuted}">
                    <Run Text="窗口标题：" />
                    <Run Text="{Binding Target.WindowTitle}" />
                  </TextBlock>
                  <TextBlock Margin="0,4,0,0" Style="{StaticResource CueMuted}">
                    <Run Text="窗口尺寸：" />
                    <Run Text="{Binding Target.Width}" />
                    <Run Text=" × " />
                    <Run Text="{Binding Target.Height}" />
                  </TextBlock>
                </StackPanel>
              </Border>
              <TextBlock Margin="0,16,0,0"
                         Style="{StaticResource CueMuted}"
                         Text="确认后将运行 3 秒倒计时并生成内存中的虚构 Transcript；不会绑定或验证任何 HWND。" />
              <StackPanel Margin="0,24,0,0"
                          HorizontalAlignment="Center"
                          Orientation="Horizontal">
                <Button Margin="0,0,12,0"
                        Command="{Binding ConfirmTargetCommand}"
                        Content="确认虚构目标并开始"
                        Style="{StaticResource CueBtnPrimary}" />
                <Button Command="{Binding CancelCommand}"
                        Content="取消"
                        Style="{StaticResource CueBtnSecondary}" />
              </StackPanel>
            </StackPanel>
          </Grid>

          <!-- 倒计时页 -->
          <Grid Style="{StaticResource CountdownPanelStyle}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock FontSize="84"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource CuePrimary}"
                         HorizontalAlignment="Center"
                         Text="{Binding CountdownRemaining}" />
              <TextBlock Margin="0,14,0,0"
                         Style="{StaticResource CueTitle}"
                         HorizontalAlignment="Center"
                         Text="Fake 预览即将开始"
                         TextAlignment="Center" />
              <TextBlock Margin="0,8,0,0"
                         Style="{StaticResource CueMuted}"
                         HorizontalAlignment="Center"
                         Text="不会读取或操作微信；可以随时取消。"
                         TextAlignment="Center" />
              <Button Width="140"
                      Margin="0,28,0,0"
                      Command="{Binding CancelCommand}"
                      Content="取消"
                      Style="{StaticResource CueBtnSecondary}" />
            </StackPanel>
          </Grid>

          <!-- 扫描页 -->
          <Grid Style="{StaticResource ScanningPanelStyle}">
            <StackPanel MaxWidth="620" HorizontalAlignment="Center">
              <ProgressBar Margin="0,0,0,22"
                           Maximum="1"
                           Minimum="0"
                           Style="{StaticResource CueProgress}"
                           Value="{Binding Progress.Percent}" />
              <TextBlock Style="{StaticResource CueTitle}"
                         HorizontalAlignment="Center"
                         Text="{Binding ProgressPhaseName}" />
              <TextBlock Margin="0,8,0,0"
                         Style="{StaticResource CueMuted}"
                         HorizontalAlignment="Center"
                         Text="{Binding Progress.Reason}"
                         TextAlignment="Center" />
              <UniformGrid Margin="0,30,0,20" Columns="3">
                <StackPanel>
                  <TextBlock FontSize="26"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource CueText}"
                             HorizontalAlignment="Center"
                             Text="{Binding Progress.ViewportCount}" />
                  <TextBlock Margin="0,4,0,0"
                             Style="{StaticResource CueCaption}"
                             HorizontalAlignment="Center"
                             Text="视口" />
                </StackPanel>
                <StackPanel>
                  <TextBlock FontSize="26"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource CueText}"
                             HorizontalAlignment="Center"
                             Text="{Binding Progress.MessageCount}" />
                  <TextBlock Margin="0,4,0,0"
                             Style="{StaticResource CueCaption}"
                             HorizontalAlignment="Center"
                             Text="消息" />
                </StackPanel>
                <StackPanel>
                  <TextBlock FontSize="26"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource CueText}"
                             HorizontalAlignment="Center"
                             Text="{Binding Progress.LowConfidenceCount}" />
                  <TextBlock Margin="0,4,0,0"
                             Style="{StaticResource CueCaption}"
                             HorizontalAlignment="Center"
                             Text="存疑" />
                </StackPanel>
              </UniformGrid>
              <TextBlock Style="{StaticResource CueMuted}"
                         HorizontalAlignment="Center"
                         Text="{Binding ProgressDescription}" />
              <StackPanel Margin="0,28,0,0"
                          HorizontalAlignment="Center"
                          Orientation="Horizontal">
                <Button Margin="0,0,12,0"
                        Command="{Binding PauseCommand}"
                        Content="暂停"
                        Style="{StaticResource CueBtnSecondary}" />
                <Button Command="{Binding FinishPartialResultCommand}"
                        Content="停止并整理已有结果"
                        Style="{StaticResource CueBtnSecondary}" />
              </StackPanel>
            </StackPanel>
          </Grid>

          <!-- 暂停页 -->
          <Grid Style="{StaticResource PausedPanelStyle}">
            <StackPanel MaxWidth="580" HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Style="{StaticResource CueDisplay}"
                         HorizontalAlignment="Center"
                         Text="Fake 扫描已暂停" />
              <TextBlock Margin="0,14,0,0"
                         Style="{StaticResource CueMuted}"
                         HorizontalAlignment="Center"
                         Text="{Binding PauseReason}"
                         TextAlignment="Center" />
              <TextBlock Margin="0,8,0,0"
                         Style="{StaticResource CueMuted}"
                         HorizontalAlignment="Center"
                         Text="暂停只影响本地虚构数据生成，不代表真实窗口的暂停能力。"
                         TextAlignment="Center" />
              <StackPanel Margin="0,26,0,0"
                          HorizontalAlignment="Center"
                          Orientation="Horizontal">
                <Button Margin="0,0,12,0"
                        Command="{Binding ResumeCommand}"
                        Content="继续"
                        Style="{StaticResource CueBtnPrimary}" />
                <Button Command="{Binding FinishPartialResultCommand}"
                        Content="整理已有结果"
                        Style="{StaticResource CueBtnSecondary}" />
              </StackPanel>
            </StackPanel>
          </Grid>

          <!-- 结果编辑页 -->
          <Grid Style="{StaticResource ResultPanelStyle}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
              <TextBlock Style="{StaticResource CueTitle}" Text="结果预览（Fake 数据）" />
              <TextBlock Margin="0,6,0,14"
                         Style="{StaticResource CueMuted}"
                         Text="{Binding ResultSummary}" />
            </StackPanel>
            <TextBox Grid.Row="1"
                     MinHeight="260"
                     AcceptsReturn="True"
                     HorizontalScrollBarVisibility="Auto"
                     Style="{StaticResource CueTextBox}"
                     Text="{Binding MarkdownText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" />
            <TextBlock Grid.Row="2"
                       Margin="0,10,0,0"
                       FontSize="13"
                       Foreground="{DynamicResource CueWarnText}"
                       Text="{Binding UserMessage}"
                       TextWrapping="Wrap" />
            <StackPanel Grid.Row="3"
                        Margin="0,16,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
              <Button Margin="0,0,10,0"
                      Command="{Binding CopyMarkdownCommand}"
                      Content="{Binding CopyButtonTitle}"
                      Style="{StaticResource CueBtnPrimary}" />
              <Button Margin="0,0,10,0"
                      Command="{Binding SaveMarkdownCommand}"
                      Content="保存 Markdown"
                      Style="{StaticResource CueBtnSecondary}" />
              <Button Command="{Binding ClearResultCommand}"
                      Content="清除并返回待机"
                      Style="{StaticResource CueBtnSecondary}" />
            </StackPanel>
          </Grid>

          <!-- 错误页 -->
          <Grid Style="{StaticResource ErrorPanelStyle}">
            <StackPanel MaxWidth="600" HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Style="{StaticResource CueDisplay}"
                         HorizontalAlignment="Center"
                         Text="Fake 预览发生问题" />
              <TextBlock Margin="0,14,0,0"
                         FontSize="15"
                         Foreground="{DynamicResource CueError}"
                         HorizontalAlignment="Center"
                         Text="{Binding ErrorMessage}"
                         TextAlignment="Center"
                         TextWrapping="Wrap" />
              <Button Width="140"
                      Margin="0,26,0,0"
                      Command="{Binding ClearResultCommand}"
                      Content="返回待机"
                      Style="{StaticResource CueBtnSecondary}" />
            </StackPanel>
          </Grid>
        </Grid>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>